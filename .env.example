# Copy to .env and fill in what you need. Every value here is optional —
# without SMTP the contact form still works and stores to data/messages.json.

# Port the server listens on (default 3000)
PORT=3000

# Bind address (default 0.0.0.0)
# HOST=0.0.0.0

# Set to true only when running behind a reverse proxy (nginx, Cloudflare,
# Fly, Railway…) so rate limiting sees the real client IP.
# TRUST_PROXY=false

# Where contact form notifications should land
CONTACT_EMAIL=your@email.com

# SMTP — if all four of HOST/USER/PASS and CONTACT_EMAIL are set,
# submissions are emailed to you as well as stored.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=your@gmail.com
